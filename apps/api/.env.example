# Copier en .env pour le développement local (docker compose up -d).
# Le schéma « lce » porte toutes les tables.
DATABASE_URL=postgresql://lce:lce_dev@localhost:5433/lce?schema=lce
REDIS_URL=redis://localhost:6380

PORT=3000
# Origines autorisées (CORS), séparées par des virgules.
ORIGINES_AUTORISEES=http://localhost:4200,http://localhost:4300

# Secrets : générer avec `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`.
JWT_SECRET=a-remplacer-par-une-valeur-aleatoire-de-48-octets
# Poivre ajouté avant de hacher les codes SMS stockés dans Redis.
OTP_POIVRE=a-remplacer-aussi

# console = codes affichés dans les journaux (développement uniquement).
SMS_PASSERELLE=console

# Compte administrateur de test créé par `npx nx run api:seed`. Valeurs de développement
# uniquement : le script refuse de s'exécuter en production.
ADMIN_TELEPHONE=+22370000098
ADMIN_MOT_DE_PASSE=lce-admin-dev-1

# Dossier des photos produit (remplacé par S3 en production).
MEDIAS_DOSSIER=medias

# E-mails. SMTP_URL vide = code affiché dans les journaux (développement uniquement).
# Avec docker compose, Mailpit reçoit les messages : lisez-les sur http://localhost:8025.
SMTP_URL=smtp://localhost:1025
EMAIL_EXPEDITEUR=Les Champs Élysées <no-reply@leschampselysees.ml>

# Connexion avec Google : identifiant client OAuth. Vide = bouton masqué.
GOOGLE_CLIENT_ID=
