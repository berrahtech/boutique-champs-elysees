generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
  moduleFormat    = "cjs"
  runtime         = "nodejs"
}

datasource db {
  provider = "postgresql"
}

model Adresse {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Unique en base seulement si par_defaut (index ux_adresse_defaut).
  utilisateurId String      @map("utilisateur_id") @db.Uuid
  zoneId        String      @map("zone_id") @db.Uuid
  libelle       String      @db.VarChar(40)
  quartier      String      @db.VarChar(80)
  repere        String      @db.VarChar(255)
  latitude      Decimal?    @db.Decimal(9, 6)
  longitude     Decimal?    @db.Decimal(9, 6)
  parDefaut     Boolean     @default(false) @map("par_defaut")
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  zone          Zone        @relation(fields: [zoneId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([utilisateurId], map: "ix_adresse_utilisateur")
  @@map("adresse")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Appareil {
  id                     String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  utilisateurId          String                  @map("utilisateur_id") @db.Uuid
  plateforme             String                  @db.VarChar(10)
  jetonFcm               String                  @unique @map("jeton_fcm")
  dernierAcces           DateTime                @default(now()) @map("dernier_acces") @db.Timestamptz(6)
  utilisateur            Utilisateur             @relation(fields: [utilisateurId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  jetonRafraichissements JetonRafraichissement[]

  @@index([utilisateurId], map: "ix_appareil_utilisateur")
  @@map("appareil")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Avis {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  produitId   String      @map("produit_id") @db.Uuid
  clientId    String      @map("client_id") @db.Uuid
  note        Int         @db.SmallInt
  commentaire String      @default("")
  publie      Boolean     @default(false)
  creeLe      DateTime    @default(now()) @map("cree_le") @db.Timestamptz(6)
  client      Utilisateur @relation(fields: [clientId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  produit     Produit     @relation(fields: [produitId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([produitId, clientId])
  @@index([produitId, creeLe(sort: Desc)], map: "ix_avis_produit_publie", where: raw("publie"))
  @@map("avis")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Categorie {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId   String?     @map("parent_id") @db.Uuid
  slug       String      @unique @db.VarChar(80)
  nom        String      @db.VarChar(80)
  ordre      Int         @default(0)
  imageUrl   String?     @map("image_url")
  parent     Categorie?  @relation("categorieTocategorie", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  enfants    Categorie[] @relation("categorieTocategorie")
  codePromos CodePromo[]
  produits   Produit[]

  @@index([parentId, ordre], map: "ix_categorie_parent")
  @@map("categorie")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model CodePromo {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String     @unique(map: "ux_code_promo_code") @db.VarChar(30)
  type            TypeRemise
  valeur          Int        @default(0)
  categorieId     String?    @map("categorie_id") @db.Uuid
  montantMinimum  Int        @default(0) @map("montant_minimum")
  debut           DateTime   @db.Timestamptz(6)
  fin             DateTime   @db.Timestamptz(6)
  utilisationsMax Int?       @map("utilisations_max")
  utilisations    Int        @default(0)
  actif           Boolean    @default(true)
  categorie       Categorie? @relation(fields: [categorieId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  commandes       Commande[]

  @@map("code_promo")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Commande {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  numero          String                @unique @default(dbgenerated("((('LCE-'::text || to_char((now() AT TIME ZONE 'Africa/Bamako'::text), 'YYYY'::text)) || '-'::text) || lpad((nextval('seq_numero_commande'::regclass))::text, 6, '0'::text))")) @db.VarChar(20)
  clientId        String                @map("client_id") @db.Uuid
  zoneId          String                @map("zone_id") @db.Uuid
  codePromoId     String?               @map("code_promo_id") @db.Uuid
  statut          StatutCommande        @default(EN_ATTENTE_PAIEMENT)
  moyen           MoyenPaiement
  sousTotal       Int                   @map("sous_total")
  fraisLivraison  Int                   @map("frais_livraison")
  remise          Int                   @default(0)
  total           Int
  adresse         Json
  noteClient      String?               @map("note_client") @db.VarChar(500)
  creeLe          DateTime              @default(now()) @map("cree_le") @db.Timestamptz(6)
  majLe           DateTime              @default(now()) @map("maj_le") @db.Timestamptz(6)
  client          Utilisateur           @relation(fields: [clientId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  codePromo       CodePromo?            @relation(fields: [codePromoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  zone            Zone                  @relation(fields: [zoneId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  historique      HistoriqueStatut[]
  lignes          LigneCommande[]
  missions        Mission[]
  mouvementStocks MouvementStock[]
  transactions    TransactionPaiement[]

  @@index([clientId, creeLe(sort: Desc)], map: "ix_commande_client")
  @@index([statut, creeLe], map: "ix_commande_statut")
  @@index([zoneId, statut], map: "ix_commande_zone_statut")
  @@map("commande")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Encaissement {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  missionId     String           @unique @map("mission_id") @db.Uuid
  livreurId     String           @map("livreur_id") @db.Uuid
  reversementId String?          @map("reversement_id") @db.Uuid
  montant       Int
  mode          ModeEncaissement
  statut        StatutCaisse     @default(A_REVERSER)
  refOperateur  String?          @map("ref_operateur") @db.VarChar(100)
  encaisseLe    DateTime         @default(now()) @map("encaisse_le") @db.Timestamptz(6)
  livreur       Livreur          @relation(fields: [livreurId], references: [utilisateurId], onDelete: NoAction, onUpdate: NoAction)
  mission       Mission          @relation(fields: [missionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reversement   Reversement?     @relation(fields: [reversementId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([livreurId], map: "ix_encaissement_caisse", where: raw("(statut = 'A_REVERSER'::statut_caisse)"))
  @@index([reversementId], map: "ix_encaissement_reversement")
  @@map("encaissement")
}

model EvenementWebhook {
  id                  BigInt               @id @default(autoincrement())
  prestataire         MoyenPaiement
  idEvenement         String               @map("id_evenement") @db.VarChar(100)
  transactionId       String?              @map("transaction_id") @db.Uuid
  charge              Json
  signatureOk         Boolean              @map("signature_ok")
  recuLe              DateTime             @default(now()) @map("recu_le") @db.Timestamptz(6)
  traiteLe            DateTime?            @map("traite_le") @db.Timestamptz(6)
  transactionPaiement TransactionPaiement? @relation(fields: [transactionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([prestataire, idEvenement])
  @@map("evenement_webhook")
}

model Favori {
  utilisateurId String      @map("utilisateur_id") @db.Uuid
  produitId     String      @map("produit_id") @db.Uuid
  ajouteLe      DateTime    @default(now()) @map("ajoute_le") @db.Timestamptz(6)
  produit       Produit     @relation(fields: [produitId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([utilisateurId, produitId])
  @@map("favori")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
