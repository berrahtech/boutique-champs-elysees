  produit   Produit @relation(fields: [produitId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([produitId, ordre])
  @@map("image_produit")
}

model JetonRafraichissement {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
