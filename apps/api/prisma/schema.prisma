  montantRembourse  Int                @default(0) @map("montant_rembourse")
  refPrestataire    String?            @map("ref_prestataire") @db.VarChar(100)
  cleIdempotence    String             @unique @map("cle_idempotence") @db.Uuid
  telephonePayeur   String?            @map("telephone_payeur") @db.VarChar(20)
  codeErreur        String?            @map("code_erreur") @db.VarChar(60)
  expireLe          DateTime?          @map("expire_le") @db.Timestamptz(6)
  creeLe            DateTime           @default(now()) @map("cree_le") @db.Timestamptz(6)
  majLe             DateTime           @default(now()) @map("maj_le") @db.Timestamptz(6)
  evenementWebhooks EvenementWebhook[]
  commande          Commande           @relation(fields: [commandeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([moyen, refPrestataire], map: "ux_transaction_ref", where: raw("(ref_prestataire IS NOT NULL)"))
  @@index([commandeId], map: "ix_transaction_commande")
  @@index([expireLe], map: "ix_transaction_expiration", where: raw("(statut = 'EN_ATTENTE'::statut_paiement)"))
  @@map("transaction_paiement")
}

