{
  "name": "design-tokens",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/design-tokens/src",
  "projectType": "library",
  "tags": [
    "scope:partage",
    "type:util"
  ],
  "// targets": "to see all targets run: nx show project design-tokens --web",
  "targets": {
    "generer": {
      "command": "node tools/jetons/generer.mjs",
      "inputs": [
        "{projectRoot}/src/jetons.json",
        "{workspaceRoot}/tools/jetons/generer.mjs",
        "{projectRoot}/src/icones.json"
      ]
    },
    "verifier": {
      "command": "node tools/jetons/generer.mjs --verifier"
    }
  }
}
